# Copia este archivo como .env y rellena los valores

# Clave de API de Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...tu_clave_aqui

# Modelo de Gemini a usar (no cambiar salvo que se actualice)
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Orígenes permitidos para CORS (separados por coma, usa * para todos)
CORS_ORIGINS=*
